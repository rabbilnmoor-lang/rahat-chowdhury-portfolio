---
import Base from "../../layouts/Base.astro";
import Flow from "../../components/Flow.astro";
import { projects } from "../../data/projects";
import { site } from "../../data/site";
import { withBase } from "../../utils";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
---
<Base title={project.title} path={`/projects/${project.slug}/`} description={project.short}>
  <!-- Header -->
  <section class="border-b border-line bg-mist">
    <div class="container-x py-14 md:py-16">
      <a href={withBase("/projects/")} class="text-sm font-semibold text-accent hover:text-navy">← All projects</a>
      <p class="mt-6 eyebrow">{project.category}</p>
      <h1 class="mt-2 max-w-4xl font-serif text-3xl font-medium leading-tight text-navy md:text-4xl">{project.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{project.short}</p>
      {project.metrics && project.metrics.length > 0 && (
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {project.metrics.map((m) => (
            <div class="card p-5">
              <p class="font-serif text-2xl font-semibold text-navy md:text-3xl">{m.value}</p>
              <p class="mt-1 text-sm text-muted">{m.label}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <div class="container-x grid gap-12 py-14 md:grid-cols-12 md:py-16">
    <!-- Main -->
    <div class="md:col-span-8 space-y-10">
      <div>
        <h2 class="font-serif text-2xl font-medium text-navy">Overview</h2>
        <p class="mt-3 leading-relaxed text-ink">{project.overview}</p>
      </div>
      <div>
        <h2 class="font-serif text-2xl font-medium text-navy">The challenge / opportunity</h2>
        <p class="mt-3 leading-relaxed text-ink">{project.challenge}</p>
      </div>
      <div>
        <h2 class="font-serif text-2xl font-medium text-navy">My role</h2>
        <p class="mt-3 leading-relaxed text-ink">{project.role}</p>
      </div>
      <div>
        <h2 class="font-serif text-2xl font-medium text-navy">What I did</h2>
        <ul class="mt-3 space-y-2">
          {project.whatIDid.map((d) => (
            <li class="flex gap-3 leading-relaxed text-ink"><span class="mt-1 text-accent">›</span><span>{d}</span></li>
          ))}
        </ul>
      </div>
      {project.execution && project.execution.length > 0 && (
        <div>
          <h2 class="font-serif text-2xl font-medium text-navy">Execution</h2>
          <div class="mt-4"><Flow steps={project.execution} /></div>
        </div>
      )}
      <div>
        <h2 class="font-serif text-2xl font-medium text-navy">Outcome / impact</h2>
        <ul class="mt-3 space-y-2">
          {project.outcome.map((o) => (
            <li class="flex gap-3 leading-relaxed text-ink"><span class="mt-1 text-accent">✓</span><span>{o}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="md:col-span-4 space-y-8">
      <div class="card p-6">
        <p class="eyebrow">Skills demonstrated</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {project.skills.map((s) => <span class="chip">{s}</span>)}
        </div>
      </div>
      {project.note && (
        <div class="rounded-lg border border-line bg-mist p-6">
          <p class="eyebrow">Note</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">{project.note}</p>
        </div>
      )}
      <div class="card p-6">
        <p class="text-sm text-muted">Want the full picture?</p>
        <a href={withBase(site.cv)} class="btn btn-primary mt-3 w-full" download>Download CV</a>
        <a href={withBase("/contact/")} class="btn btn-ghost mt-2 w-full">Get in touch</a>
      </div>
    </aside>
  </div>
</Base>
