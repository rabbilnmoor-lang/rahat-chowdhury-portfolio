---
interface Props { value: string; label: string; }
const { value, label } = Astro.props;
---
<div class="card p-6">
  <p class="font-serif text-2xl font-semibold tracking-tight text-navy whitespace-nowrap md:text-3xl lg:text-2xl">{value}</p>
  <p class="mt-2 text-sm leading-snug text-muted">{label}</p>
</div>
