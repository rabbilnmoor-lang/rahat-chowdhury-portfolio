---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { site } from "../data/site";
import { experience, education } from "../data/about";
import { expertise } from "../data/expertise";
import { withBase } from "../utils";
const competencies = expertise.flatMap((g) => g.items).slice(0, 16);
---
<Base title="CV" path="/cv/" description="Curriculum vitae of Mohammad Abul Rahat Chowdhury — summary, competencies, experience and education, with a downloadable PDF.">
  <Section eyebrow="Curriculum vitae" title="My CV at a glance">
    <div class="flex flex-wrap gap-3">
      <a href={withBase(site.cv)} class="btn btn-primary" download>Download CV (PDF)</a>
      <a href={withBase(site.cv)} target="_blank" rel="noopener" class="btn btn-ghost">Open in new tab</a>
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-12">
      <div class="md:col-span-8 space-y-10">
        <div>
          <h2 class="font-serif text-2xl font-medium text-navy">Professional summary</h2>
          <p class="mt-3 leading-relaxed text-ink">
            Strategy and business-development professional with about eight years across aviation, airline GSA,
            freight forwarding, logistics, infrastructure and corporate strategy. Takes commercial and corporate
            projects from planning and analysis through to execution, and improves how operations run. Combines
            business expertise with engineering rigor.
          </p>
        </div>
        <div>
          <h2 class="font-serif text-2xl font-medium text-navy">Experience</h2>
          <div class="mt-4 space-y-6">
            {experience.map((job) => (
              <div>
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-semibold text-navy">{job.role} — {job.org}</h3>
                  <span class="whitespace-nowrap text-sm font-semibold text-accent">{job.period}</span>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-muted">{job.summary}</p>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h2 class="font-serif text-2xl font-medium text-navy">Education</h2>
          <div class="mt-4 space-y-3">
            {education.map((e) => (
              <div class="flex items-baseline justify-between gap-4">
                <p class="text-sm"><span class="font-semibold text-navy">{e.degree}</span> — {e.institution}</p>
                <span class="whitespace-nowrap text-sm font-semibold text-accent">{e.year}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <aside class="md:col-span-4">
        <div class="card p-6">
          <p class="eyebrow">Core competencies</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {competencies.map((c) => <span class="chip">{c}</span>)}
          </div>
        </div>
      </aside>
    </div>
  </Section>
</Base>
