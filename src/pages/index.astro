---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import MetricCard from "../components/MetricCard.astro";
import Pillar from "../components/Pillar.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Flow from "../components/Flow.astro";
import { site, metrics, narrative } from "../data/site";
import { pillars } from "../data/about";
import { featuredProjects } from "../data/projects";
import { withBase } from "../utils";
---
<Base path="/">
  <!-- HERO -->
  <section class="border-b border-line bg-mist">
    <div class="container-x grid items-center gap-10 py-16 md:grid-cols-12 md:py-24">
      <div class="md:col-span-7">
        <p class="eyebrow">{site.location}</p>
        <h1 class="mt-3 font-serif text-4xl font-medium leading-[1.1] text-navy md:text-6xl">
          Mohammad Abul<br />Rahat Chowdhury
        </h1>
        <p class="mt-5 text-xl font-semibold text-slate2 md:text-2xl">Strategy &amp; Business Development Professional</p>
        <p class="mt-2 text-base text-muted md:text-lg">Aviation &nbsp;·&nbsp; Logistics &nbsp;·&nbsp; Corporate Strategy &nbsp;·&nbsp; Project Execution</p>
        <p class="mt-6 max-w-2xl text-[17px] leading-relaxed text-ink">
          I work at the intersection of strategy, commercial development, project execution and operations —
          analysing opportunities, structuring the business case, developing and negotiating commercial deals,
          and coordinating complex projects through to implementation.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={withBase("/projects/")} class="btn btn-primary">Explore my work</a>
          <a href={withBase(site.cv)} class="btn btn-ghost" download>Download CV</a>
          <a href={site.linkedin} target="_blank" rel="noopener" class="text-sm font-semibold text-navy hover:text-accent">LinkedIn ↗</a>
        </div>
        <div class="mt-8 flex flex-wrap gap-2">
          <span class="chip">Corporate Strategy</span>
          <span class="chip">Business Development</span>
          <span class="chip">Project Management</span>
          <span class="chip">Business Operations</span>
        </div>
      </div>

      <div class="md:col-span-5">
        <figure class="mx-auto max-w-xs md:max-w-none">
          <img
            src={withBase(site.photo)}
            srcset={`${withBase(site.photoSm)} 480w, ${withBase(site.photo)} 900w`}
            sizes="(min-width: 768px) 38vw, 80vw"
            width="900" height="1234"
            alt="Portrait of Mohammad Abul Rahat Chowdhury"
            class="w-full rounded-xl border border-line object-cover shadow-[0_20px_50px_rgba(15,42,71,0.16)]"
            loading="eager" fetchpriority="high"
          />
          <figcaption class="mt-3 text-center text-sm text-muted md:text-left">
            <span class="font-semibold text-navy">Senior Analyst — Expo Group</span> · {site.location}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- METRICS -->
  <section class="border-b border-line py-14">
    <div class="container-x">
      <p class="eyebrow">Documented career &amp; project outcomes</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {metrics.map((m) => <MetricCard value={m.value} label={m.label} />)}
      </div>
      <p class="mt-4 text-xs text-muted">Figures reflect project and career outcomes I led or coordinated, not businesses I personally own.</p>
    </div>
  </section>

  <!-- NARRATIVE -->
  <Section eyebrow="How I work" title="From opportunity to operating result">
    <Flow steps={narrative} />
    <p class="mt-6 max-w-2xl text-muted">
      The through-line of my work: understand the objective, structure the solution, and work with stakeholders to execute it.
    </p>
  </Section>

  <!-- FEATURED PROJECTS -->
  <section class="border-y border-line bg-mist">
    <div class="container-x py-16 md:py-20">
      <div class="mb-10 flex items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow">Selected work</p>
          <h2 class="mt-2 font-serif text-3xl font-medium text-navy md:text-4xl">Flagship projects</h2>
        </div>
        <a href={withBase("/projects/")} class="hidden shrink-0 text-sm font-semibold text-accent hover:text-navy sm:block">All projects →</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {featuredProjects.map((p) => <ProjectCard project={p} />)}
      </div>
      <a href={withBase("/projects/")} class="mt-8 inline-block text-sm font-semibold text-accent hover:text-navy sm:hidden">All projects →</a>
    </div>
  </section>

  <!-- PILLARS -->
  <Section eyebrow="Capabilities" title="What I bring">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((p, i) => <Pillar index={i + 1} title={p.title} body={p.body} />)}
    </div>
  </Section>

  <!-- CTA -->
  <section class="bg-navy">
    <div class="container-x flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center">
      <div>
        <h2 class="font-serif text-2xl font-medium text-white md:text-3xl">Let’s talk</h2>
        <p class="mt-2 max-w-xl text-slate-200/80">
          Open to roles where strategy, commercial development, aviation, logistics and execution come together.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={withBase("/contact/")} class="btn bg-white text-navy hover:bg-mist">Contact me</a>
        <a href={withBase(site.cv)} class="btn border border-white/30 text-white hover:bg-white/10" download>Download CV</a>
      </div>
    </div>
  </section>
</Base>
