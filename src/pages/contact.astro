---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { site } from "../data/site";
import { contactTargets } from "../data/expertise";
import { withBase } from "../utils";
---
<Base title="Contact" path="/contact/" description="Get in touch about Manager / Senior Manager roles in corporate strategy, strategic projects, project management, business planning and business development.">
  <Section eyebrow="Contact" title="Let’s talk">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="max-w-xl text-[17px] leading-relaxed text-ink">
          I am interested in Manager / Senior Manager opportunities where corporate strategy, strategic
          projects, business planning and execution come together. If that sounds like a fit, I would welcome a conversation.
        </p>
        <div class="mt-8 space-y-4">
          <a href={`mailto:${site.email}`} class="flex items-center gap-3 text-navy hover:text-accent">
            <span class="eyebrow w-24">Email</span><span class="text-[15px] font-medium">{site.email}</span>
          </a>
          <a href={site.linkedin} target="_blank" rel="noopener" class="flex items-center gap-3 text-navy hover:text-accent">
            <span class="eyebrow w-24">LinkedIn</span><span class="text-[15px] font-medium">{site.linkedinLabel}</span>
          </a>
          <div class="flex items-center gap-3">
            <span class="eyebrow w-24">Location</span><span class="text-[15px] text-muted">{site.location}</span>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${site.email}`} class="btn btn-primary">Email me</a>
          <a href={withBase(site.cv)} class="btn btn-ghost" download>Download CV</a>
          <a href={withBase(site.coverLetter)} class="btn btn-ghost" download>Download cover letter</a>
        </div>
      </div>
      <aside class="md:col-span-5">
        <div class="card p-6">
          <p class="eyebrow">Areas of interest</p>
          <ul class="mt-3 space-y-2">
            {contactTargets.map((t) => (
              <li class="flex gap-2 text-sm text-muted"><span class="text-accent">›</span><span>{t}</span></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </Section>
</Base>
