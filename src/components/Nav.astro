---
import { site, nav } from "../data/site";
import { withBase } from "../utils";
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const h = withBase(href).replace(/\/+$/, "") || "/";
  return h === "/" ? current === withBase("/").replace(/\/+$/, "") || current === "/" : current.startsWith(h);
};
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
  <nav class="container-x flex h-16 items-center justify-between">
    <a href={withBase("/")} class="group flex flex-col leading-none">
      <span class="text-[15px] font-semibold text-navy">Mohammad Abul Rahat Chowdhury</span>
      <span class="mt-0.5 text-[11px] font-medium uppercase tracking-[0.12em] text-muted">Corporate Strategy · Strategic Projects</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 lg:flex">
      {nav.map((item) => (
        <li>
          <a
            href={withBase(item.href)}
            class:list={["rounded px-3 py-2 text-sm transition-colors", isActive(item.href) ? "font-semibold text-navy" : "text-muted hover:text-navy"]}
          >{item.label}</a>
        </li>
      ))}
    </ul>

    <!-- Mobile: details/summary menu (no JS) -->
    <details class="relative lg:hidden">
      <summary class="list-none cursor-pointer rounded-md border border-line px-3 py-2 text-sm font-medium text-navy [&::-webkit-details-marker]:hidden">Menu</summary>
      <ul class="absolute right-0 z-50 mt-2 w-56 rounded-lg border border-line bg-paper p-2 shadow-lg">
        {nav.map((item) => (
          <li>
            <a href={withBase(item.href)} class="block rounded px-3 py-2 text-sm text-ink hover:bg-mist">{item.label}</a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
