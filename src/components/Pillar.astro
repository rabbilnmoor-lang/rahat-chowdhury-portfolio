---
interface Props { index: number; title: string; body: string; }
const { index, title, body } = Astro.props;
const n = String(index).padStart(2, "0");
---
<div class="card card-hover p-6">
  <span class="font-serif text-sm text-accent">{n}</span>
  <h3 class="mt-2 text-lg font-semibold text-navy">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-muted">{body}</p>
</div>
