---
import { site, nav } from "../data/site";
import { withBase } from "../utils";
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-line bg-mist">
  <div class="container-x grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="text-sm font-semibold text-navy">{site.name}</p>
      <p class="mt-2 text-sm text-muted">{site.positioning}</p>
      <p class="mt-1 text-sm text-muted">{site.location}</p>
    </div>
    <div>
      <p class="eyebrow">Navigate</p>
      <ul class="mt-3 grid grid-cols-2 gap-1">
        {nav.map((item) => (
          <li><a href={withBase(item.href)} class="text-sm text-muted hover:text-navy">{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="eyebrow">Get in touch</p>
      <ul class="mt-3 space-y-1.5">
        <li><a href={`mailto:${site.email}`} class="text-sm text-muted hover:text-navy">{site.email}</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener" class="text-sm text-muted hover:text-navy">LinkedIn</a></li>
        <li><a href={withBase(site.cv)} class="text-sm text-muted hover:text-navy">Download CV</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-5 text-xs text-muted sm:flex-row">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Built with Astro & Tailwind · Hosted on GitHub Pages</p>
    </div>
  </div>
</footer>
