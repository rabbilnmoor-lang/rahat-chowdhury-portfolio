---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
---
<Base title="Projects" path="/projects/" description="Selected projects and business impact across airline GSA, logistics infrastructure, operations, partnerships and financial modelling.">
  <Section eyebrow="Selected projects & business impact" title="Evidence of how I work" lead="Each case study shows the opportunity, my role, what I did, and the outcome — grounded in real projects.">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </Section>
</Base>
